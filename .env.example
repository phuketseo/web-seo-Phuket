# Copy to .env.local and fill in production values before deploy

# Site URL (used for metadataBase, canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://phuketseo.com

# Google Analytics 4 — Measurement ID (public site tag)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Optional numeric Property ID for Admin Data API (Admin → Property settings)
# If omitted, admin resolves property by Measurement ID via Analytics Admin API
# GA4_PROPERTY_ID=123456789

# LINE Official Account ID for chat widget
NEXT_PUBLIC_LINE_OA=@phuketseo

# Resend API key for contact form — https://resend.com
RESEND_API_KEY=re_XXXXXXXXXX

# Email that receives contact form submissions
CONTACT_EMAIL=phuketseo369@gmail.com

# --- Admin dashboard (/admin) ---
# Password for login page
ADMIN_PASSWORD=change-me
# Random long string stored in httpOnly cookie after login
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Google Search Console ---
# Property URL exactly as in GSC (URL-prefix must end with /)
# Domain property example: sc-domain:phuketseo.com
GSC_SITE_URL=https://phuketseo.com/

# OAuth (recommended — no service account JSON key needed)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/gsc/oauth/callback
# Optional: paste refresh token for production (otherwise stored in .data/gsc-oauth.json locally)
# GSC_OAUTH_REFRESH_TOKEN=

# Service account (optional fallback — blocked by some org policies)
# GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: SerpAPI for true organic rank when clicking "เช็คอันดับล่าสุด" in /admin
# https://serpapi.com — without this key, admin uses GSC exact-query position only
# SERPAPI_KEY=
